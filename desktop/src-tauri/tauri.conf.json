{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DynastyTrust",
  "version": "0.1.0",
  "identifier": "family.dynastytrust.desktop",
  "build": {
    "frontendDist": "../../apps/web/dist-download"
  },
  "app": {
    "windows": [
      {
        "title": "DynastyTrust",
        "width": 1100,
        "height": 800,
        "minWidth": 375,
        "minHeight": 600,
        "create": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
