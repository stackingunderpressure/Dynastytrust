# Frontend env vars live in apps/web/.env (see apps/web/.env.example)
# Backend env vars are set in the Netlify dashboard for production,
# or in a root .env for local `netlify dev`:
#
#   SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
#   COMPILER_URL=
#   COMPILER_SECRET=
